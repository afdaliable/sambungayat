---
import { DEFAULT_LANG, getDict, t, type Lang } from "../lib/i18n";
import BaseLayout from "../layouts/BaseLayout.astro";
import RecapView from "../components/teacher/RecapView";
interface Props {
  lang?: Lang;
}
const { lang = DEFAULT_LANG } = Astro.props;
const dict = getDict(lang, ["pages"]);
const islandDict = getDict(lang, ["quiz", "settings", "teacher", "lib", "common"]);
---

<BaseLayout
  lang={lang}
  title={t(dict, "pages.rekap.title")}
  noindex
  description={t(dict, "pages.rekap.description")}
>
  <main id="main" class="wrap py-6 lg:py-10">
    <h1 class="title mb-6">{t(dict, "pages.rekap.h1")}</h1>
    <RecapView client:load lang={lang} dict={islandDict} />
    <p class="measure mt-8 text-sm text-muted">{t(dict, "pages.rekap.privacy")}</p>
  </main>
</BaseLayout>
