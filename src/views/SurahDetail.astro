---
import { DEFAULT_LANG, getDict, localePath, t, tp, type Lang } from "../lib/i18n";
import { trTexts } from "../lib/translationFile";
import BaseLayout from "../layouts/BaseLayout.astro";
import ShareBar from "../components/ui/ShareBar.astro";
import { SITE } from "../config/site";
import type { SurahMeta } from "../lib/quran/types";

interface Props {
  lang?: Lang;
  s: SurahMeta;
  prev?: SurahMeta;
  next?: SurahMeta;
  sample: { a: number; ar: string; id: string }[];
}
const { s, prev, next, sample, lang = DEFAULT_LANG } = Astro.props;
const sampleTr = trTexts(lang, s.n);
const dict = getDict(lang, ["pages"]);
const juzText =
  s.juz.length > 1
    ? t(dict, "pages.juzText.range", { from: s.juz[0]!, to: s.juz[s.juz.length - 1]! })
    : t(dict, "pages.juzText.single", { n: s.juz[0]! });
const revelation = t(dict, `pages.revelation.${s.revelation}`);
const ayahs = tp(lang, dict, "pages.ayahCount", s.ayahCount);
const dash = String.fromCharCode(0x2014);
const title = t(dict, "pages.surah.title", { name: s.nameLatin, dash });
const description = t(dict, "pages.surah.description", {
  name: s.nameLatin,
  ayahs,
  revelation,
  juz: juzText,
});
const pageUrl = `${SITE.url}${localePath(lang, `/surah/${s.slug}`)}`;
const learning = {
  "@context": "https://schema.org",
  "@type": "LearningResource",
  name: t(dict, "pages.surah.ldName", { name: s.nameLatin }),
  description,
  inLanguage: lang,
  learningResourceType: "Quiz",
  educationalLevel: t(dict, "pages.surah.ldLevel"),
  isAccessibleForFree: true,
  url: pageUrl,
};
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: SITE.name, item: SITE.url + localePath(lang, "/") },
    {
      "@type": "ListItem",
      position: 2,
      name: t(dict, "pages.breadcrumb.surah"),
      item: SITE.url + localePath(lang, "/surah"),
    },
    { "@type": "ListItem", position: 3, name: s.nameLatin, item: pageUrl },
  ],
};
const jsonLd = [breadcrumb, learning];
---

<BaseLayout lang={lang} title={title} description={description} jsonLd={jsonLd}>
  <main id="main" class="wrap py-6 lg:py-10">
    <nav aria-label={t(dict, "pages.breadcrumb.label")} class="text-sm text-muted">
      <a class="lnk" href={localePath(lang, "/surah")}>
        {t(dict, "pages.breadcrumb.surah")}
      </a>{" "}
      / {s.nameLatin}
    </nav>
    <div class="mt-4 grid gap-x-14 gap-y-10 lg:grid-cols-2 lg:items-start">
      <div class="lg:sticky lg:top-6">
        <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1">
          <h1 class="title">{t(dict, "pages.surah.h1", { name: s.nameLatin })}</h1>
          <p lang="ar" dir="rtl" class="ayah">
            {s.nameAr}
          </p>
        </div>

        <p class="mt-4">
          {t(dict, "pages.surah.intro", { name: s.nameLatin, n: s.n, revelation, ayahs })}
        </p>

        <div class="mt-7 grid gap-2">
          <a
            class="btn btn-lg"
            href={localePath(lang, `/kuis?mode=sambung&scope=surah:${s.n}&n=10&d=mudah`)}
          >
            {t(dict, "pages.surah.startSambung")}
          </a>
          <a
            class="btn-quiet"
            href={localePath(lang, `/kuis?mode=tebak-surah&scope=juz:${s.juz[0]}&n=10&d=mudah`)}
          >
            {t(dict, "pages.surah.startTebak")}
          </a>
        </div>

        <dl class="rows mt-9">
          <div class="flex items-baseline justify-between gap-4 py-2.5">
            <dt class="text-muted">{t(dict, "pages.surah.number")}</dt>
            <dd class="num font-semibold">{s.n}</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 py-2.5">
            <dt class="text-muted">{t(dict, "pages.surah.count")}</dt>
            <dd class="num font-semibold">{s.ayahCount}</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 py-2.5">
            <dt class="text-muted">{t(dict, "pages.surah.type")}</dt>
            <dd class="font-semibold">{revelation}</dd>
          </div>
        </dl>
        <p class="mt-3 text-sm text-muted">{t(dict, "pages.surah.locatedIn", { juz: juzText })}</p>

        <ShareBar
          lang={lang}
          url={pageUrl}
          text={t(dict, "pages.surah.shareText", { name: s.nameLatin })}
        />
      </div>

      <section>
        <h2 class="sub">{t(dict, "pages.surah.opening")}</h2>
        <ol class="rows mt-4">
          {sample.map((x) => (
            <li class="py-4">
              <p lang="ar" dir="rtl" class="ayah">
                {x.ar}
              </p>
              <p class="num mt-2 text-sm text-muted">
                {x.a}. {sampleTr ? sampleTr[x.a - 1] : x.id}
              </p>
            </li>
          ))}
        </ol>
      </section>
    </div>

    <nav aria-label={t(dict, "pages.surah.others")} class="mt-12 flex justify-between gap-3 border-t border-line pt-3">
      {prev ? (
        <a class="lnk inline-flex min-h-11 items-center" href={localePath(lang, `/surah/${prev.slug}`)}>
          <svg class="inline-block size-4 rtl:-scale-x-100" viewBox="0 0 20 20" aria-hidden="true"><path d="M16 10H4m5-5-5 5 5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>&nbsp;{prev.nameLatin}
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a class="lnk inline-flex min-h-11 items-center" href={localePath(lang, `/surah/${next.slug}`)}>
          {next.nameLatin}&nbsp;<svg class="inline-block size-4 rtl:-scale-x-100" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </a>
      )}
    </nav>
  </main>
</BaseLayout>
